# copy to .env ; never commit .env
DD_FEED=synthetic            # desk feed: synthetic | replay | kite | upstox | dhan
DD_QUOTES=yahoo              # markets-page quotes: synthetic | yahoo (15 min delayed, no account) | upstox
DD_MODE=paper                # paper | live
DD_UNDERLYING=NIFTY
DD_AUTO_APPROVE=false        # paper only: approve decisions above threshold automatically
DD_CONFIDENCE_THRESHOLD=0.65
# broker credentials (only for the feed you selected)
KITE_API_KEY=
KITE_ACCESS_TOKEN=
# Upstox (free market data): create an app at https://account.upstox.com/developer/apps
# with redirect URL http://127.0.0.1:8765/upstox/callback, then run: uv run deltadesk login upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/upstox/callback
UPSTOX_ACCESS_TOKEN=          # optional: overrides the cached daily token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Alerts (optional). WhatsApp Cloud API from developers.facebook.com, or a Telegram bot from @BotFather. Without them alerts are logged only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TELEGRAM_BOT_TOKEN=

# admin: traffic summary at /admin/traffic?token=...  (leave empty to disable)
DD_ADMIN_TOKEN=
# optional: fixed salt for daily visitor hashes (random per process start when empty)
DD_TRAFFIC_SALT=

# language model behind the Fundamental / Technical agent chat (all free tiers; leave empty for the rules fallback)
DD_LLM=auto                  # auto | groq | gemini | openrouter | ollama | none
GROQ_API_KEY=                # console.groq.com
GEMINI_API_KEY=              # aistudio.google.com
OPENROUTER_API_KEY=          # openrouter.ai (use a model with the :free suffix)
OLLAMA_MODEL=llama3.2        # only when DD_LLM=ollama

# owner ping: your own Telegram chat id; every new waitlist sign-up is sent there (needs TELEGRAM_BOT_TOKEN)
DD_OWNER_CHAT=

# waitlist store: a Postgres URL (Neon or Supabase free tier) keeps sign-ups across redeploys; empty = data/waitlist.jsonl
DATABASE_URL=
